# API y worker locales, conectados a una instancia de SQL Server existente.
MSSQL_SERVER=localhost
MSSQL_DATABASE=ProInXML
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUSTED_CONNECTION=yes
MSSQL_ENCRYPT=yes
# Solo para el certificado local de desarrollo.
MSSQL_TRUST_SERVER_CERTIFICATE=yes
# Para autenticacion SQL: TRUSTED_CONNECTION=no y completar estas variables.
MSSQL_USER=
MSSQL_PASSWORD=
WORKER_POLL_SECONDS=5
# Descargas simultaneas. Para comparar ensayos, cambiar y reiniciar el worker.
WORKER_CONCURRENCY=8
MAX_XML_BYTES=33554432
MEF_CIRCUIT_FAILURES=5
MEF_CIRCUIT_PAUSE_SECONDS=30
SESSION_SECONDS=28800
# yes al servir mediante HTTPS. Para localhost con HTTP usar no.
COOKIE_SECURE=no
